<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EstoqueMAUI.MainPage"
    Title="Cadastro de Produtos"
    BackgroundColor="#F1F5F9">

    <!-- ESTILOS REUTILIZÁVEIS -->
    <ContentPage.Resources>

        <!-- Estilo dos campos de entrada -->
        <Style x:Key="CampoEstilo"
               TargetType="Entry">
            <Setter Property="HeightRequest"
                    Value="45"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="TextColor"
                    Value="#1E293B"/>
            <Setter Property="PlaceholderColor"
                    Value="#94A3B8"/>
            <Setter Property="BackgroundColor"
                    Value="#F1F5F9"/>
        </Style>

        <!-- Estilo do botão principal -->
        <Style x:Key="BotaoEstilo"
               TargetType="Button">
            <Setter Property="HeightRequest"
                    Value="45"/>
            <Setter Property="WidthRequest"
                    Value="220"/>
            <Setter Property="CornerRadius"
                    Value="9"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontAttributes"
                    Value="Bold"/>
            <Setter Property="BackgroundColor"
                    Value="#005CA9"/>
            <Setter Property="TextColor"
                    Value="White"/>
        </Style>

    </ContentPage.Resources>

    <!-- GRID PRINCIPAL -->
    <Grid
        RowDefinitions="68,*"
        ColumnDefinitions="210,*"
        RowSpacing="0"
        ColumnSpacing="0">

        <!-- CABEÇALHO SUPERIOR -->
        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            BackgroundColor="#0B2D4D"
            Padding="22,0"
            ColumnDefinitions="*,Auto">

            <Label
                Text="ESTOQUE MAUI"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"/>

            <Label
                Grid.Column="1"
                Text="GESTÃO DE PRODUTOS"
                FontSize="12"
                TextColor="#DCEAF5"
                VerticalOptions="Center"/>

        </Grid>

        <!-- MENU LATERAL -->
        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            BackgroundColor="#123B5D"
            Padding="18,22"
            Spacing="16">

            <Label
                Text="MENU PRINCIPAL"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#AFC8DD"/>

            <Border
                BackgroundColor="#245577"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                Padding="12">

                <Label
                    Text="Produtos"
                    FontSize="14"
                    TextColor="White"
                    FontAttributes="Bold"/>

            </Border>

            <Label
                Text="Relatórios"
                FontSize="14"
                TextColor="#DCEAF5"/>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#FFFFFF"
                Opacity="0.25"/>

            <Label
                Text="Sistema de controle de estoque"
                FontSize="11"
                TextColor="#AFC8DD"/>

        </VerticalStackLayout>

        <!-- ÁREA PRINCIPAL -->
        <ScrollView
            Grid.Row="1"
            Grid.Column="1"
            BackgroundColor="#F1F5F9">

            <VerticalStackLayout
                Padding="28"
                Spacing="18">

                <!-- TÍTULO DA TELA -->
                <Label
                    Text="Cadastro de produtos"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#1E293B"/>

                <Label
                    Text="Informe os dados para cadastrar um novo produto."
                    FontSize="13"
                    TextColor="#64748B"/>

                <!-- CARTÃO DO FORMULÁRIO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE5EF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="22">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnDefinitions="*,*"
                        RowSpacing="12"
                        ColumnSpacing="16">

                        <!-- TÍTULO DO FORMULÁRIO -->
                        <Label
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Text="INFORMAÇÕES DO PRODUTO"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#005CA9"/>

                        <!-- RÓTULOS DOS CAMPOS -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Nome do produto"
                            FontSize="12"
                            TextColor="#475569"/>

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Quantidade"
                            FontSize="12"
                            TextColor="#475569"/>

                        <!-- CAMPO NOME -->
                        <Entry
                            Grid.Row="2"
                            Grid.Column="0"
                            x:Name="NomeEntry"
                            Placeholder="Digite o produto"
                            Style="{StaticResource CampoEstilo}"/>

                        <!-- CAMPO QUANTIDADE -->
                        <Entry
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="QuantidadeEntry"
                            Placeholder="Digite a quantidade"
                            Keyboard="Numeric"
                            Style="{StaticResource CampoEstilo}"/>

                        <!-- BOTÃO CADASTRAR -->
                        <Button
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Text="Cadastrar produto"
                            Clicked="OnAdicionarClicked"
                            HorizontalOptions="Start"
                            Style="{StaticResource BotaoEstilo}"/>

                        <!-- BOTÃO CONSULTAR -->
                        <Button
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Text="Consultar produtos"
                            Clicked="OnConsultarClicked"
                            HorizontalOptions="Start"
                            Style="{StaticResource BotaoEstilo}"/>

                        <!-- RESULTADO -->
                        <Label
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            x:Name="ResultadoLabel"
                            Text="Preencha os dados do produto."
                            FontSize="13"
                            TextColor="#334155"/>

                    </Grid>

                </Border>

                <!-- PAINEL COM TRANSPARÊNCIA -->
                <Border
                    BackgroundColor="#33005CA9"
                    Stroke="#55005CA9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="DICA DE USABILIDADE"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#005CA9"/>

                        <Label
                            Text="Utilize campos organizados, textos objetivos e cores que facilitem a identificação das funcionalidades."
                            FontSize="12"
                            TextColor="#334155"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
